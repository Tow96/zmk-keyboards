#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I         &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K         &kp L    &kp SEMI  &kp RET
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA     &kp DOT  &tog 4    &kp FSLH
                         &kp LGUI  &mo 2  &kp LCTRL    &kp SPACE  &mo 1  &kp LEFT_ALT
            >;

            label = "Base";
        };

        lower {
            bindings = <
&kp GRAVE  &kp N1           &kp N2  &kp N3  &kp N4  &kp N5       &kp N6     &kp N7     &kp N8    &kp N9    &kp N0  &kp DEL
&trans     &trans           &trans  &trans  &trans  &trans       &kp LBKT   &kp RBKT   &kp SQT   &kp BSLH  &trans  &trans
&trans     &kp NON_US_BSLH  &trans  &trans  &trans  &trans       &kp MINUS  &kp EQUAL  &trans    &trans    &trans  &trans
                                    &trans  &trans  &kp RCTRL    &trans     &trans     &sk RALT
            >;

            label = "Low";
        };

        upper {
            bindings = <
&kp LS(TILDE)  &kp LS(EXCL)         &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&trans         &trans               &trans      &trans         &trans        &trans           &kp LS(LBRC)   &kp LS(RBRC)  &kp LS(DQT)   &kp LS(BSLH)  &trans        &trans
&trans         &kp LS(NON_US_BSLH)  &trans      &trans         &trans        &trans           &kp LS(UNDER)  &kp LS(PLUS)  &trans        &trans        &trans        &trans
                                                &trans         &trans        &trans           &trans         &trans        &trans
            >;

            label = "Up";
        };

        function {
            bindings = <
&kp F1        &kp F2         &kp F3        &kp F4        &kp F5        &kp F6          &kp F7      &kp F8     &kp F9   &kp F10   &kp F11  &kp F12
&kp CAPSLOCK  &kp C_AL_CALC  &trans        &trans        &trans        &trans          &kp PG_UP   &kp PG_DN  &kp INS  &kp HOME  &kp END  &kp DEL
&trans        &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &trans     &trans   &trans    &trans   &bt BT_CLR_ALL
                                           &trans        &trans        &trans          &trans      &trans     &trans
            >;

            label = "Fn";
        };

        extended {
            bindings = <
&kp ESCAPE      &none           &kp UP_ARROW    &none         &none  &kp C_BRIGHTNESS_INC    &none      &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none   &trans
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &none  &kp C_BRIGHTNESS_DEC    &none      &kp C_PREV  &kp C_PP      &kp C_NEXT    &none   &kp ENTER
&kp LEFT_SHIFT  &none           &none           &none         &none  &none                   &none      &none       &none         &none         &tog 4  &trans
                                                &kp LEFT_GUI  &mo 5  &kp LCTRL               &kp SPACE  &mo 5       &kp LEFT_ALT
            >;

            label = "Ext";
        };

        Extended_upper {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_N7        &kp KP_N8   &kp KP_N9  &kp KP_SUBTRACT  &kp KP_DIVIDE  &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_N4        &kp KP_N5   &kp KP_N6  &kp KP_PLUS      &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_NUMBER_1  &kp KP_N2   &kp KP_N3  &kp RET          &trans         &trans
                        &trans  &trans  &trans    &kp KP_N0        &kp KP_DOT  &trans
            >;

            label = "e_up";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Both {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
